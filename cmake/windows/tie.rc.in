#include <winver.h>
IDI_ICON1 ICON "@TIE_WINDOWS_ICON@"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @TIE_VERSION_MAJOR@,@TIE_VERSION_MINOR@,@TIE_VERSION_PATCH@,0
PRODUCTVERSION @TIE_VERSION_MAJOR@,@TIE_VERSION_MINOR@,@TIE_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo" BEGIN
    BLOCK "040904B0" BEGIN
      VALUE "FileDescription", "OpenTIE"
      VALUE "FileVersion", "@TIE_VERSION@"
      VALUE "InternalName", "OpenTIE"
      VALUE "OriginalFilename", "OpenTIE.exe"
      VALUE "ProductName", "OpenTIE"
      VALUE "ProductVersion", "@TIE_VERSION@"
    END
  END
  BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
